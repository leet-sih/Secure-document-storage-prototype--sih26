# ══════════════════════════════════════════════════════════════════
# Root .gitignore — applies to the whole repo (SIH26/). Patterns match
# at any depth, so this also covers codebase/backend, codebase/frontend, etc.
# ══════════════════════════════════════════════════════════════════

# ── Secrets — NEVER commit these ──
.env
.env.*
!.env.example
*.pem
*.key
*.crt
**/nginx/certs/*
!**/nginx/certs/README.md
vault-data/
secrets/

# ── Python (backend) ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
instance/

# ── Node / React (frontend) ──
node_modules/
dist/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Local prototype storage — encrypted chunks + master keys. NEVER commit. ──
data/
data/chunks/
**/backend/data/

# ── Docker / data volumes ──
postgres-data/
minio-data/
redis-data/
qdrant-storage/
ollama-models/

# ── Editor / OS ──
.idea/
.vscode/
.DS_Store
Thumbs.db
