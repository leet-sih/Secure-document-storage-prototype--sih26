# ══════════════════════════════════════════════════════════════════
# .env.example — copy to .env and fill in. NEVER commit .env.
# PRAMAAN — Secure Evidence Vault (leet / SIH26)
# PROTOTYPE config: PostgreSQL + two-server chunk store + local file KMS.
# No Redis/MinIO/Vault/Celery in prototype.
# ══════════════════════════════════════════════════════════════════

# ── Database (Flask is SYNC — psycopg driver, NOT asyncpg) ──
# Server A = PostgreSQL (metadata). Backend-in-Docker -> host is 'postgres'.
DATABASE_URL=postgresql+psycopg://dms_app_user:devpassword@localhost:5432/dms
POSTGRES_USER=dms_app_user
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=dms

# ── Storage topology (prototype: two-server separation) ──
# SERVER A = PostgreSQL (metadata only). SERVER B = encrypted chunk store (ciphertext only).
# Compromising either server alone does not yield enough to reconstruct a document.
CHUNK_STORE_BACKEND=local          # local | sftp  (use sftp for the real two-server demo)
CHUNK_STORE_HOST=                  # blank = same host (dev only); set to Server B hostname for demo
CHUNK_STORAGE_DIR=./data/chunks    # path ON Server B where ciphertext chunks land
CHUNK_STORE_USER=                  # OS user on Server B (sftp backend)
CHUNK_STORE_KEYFILE=               # path to SSH private key for sftp auth (no passwords)

# ── KMS (local file store — prototype; HashiCorp Vault in production) ──
# KMS boundary: prototype stores AES-wrapped master keys in KMS_DIR on the app host,
# wrapped with KMS_WRAPPING_KEY. This is a SEPARATE secret from SECRET_KEY.
# See docs/ARCHITECTURE.md "KMS boundary" and docs/SECURITY.md "Key lifecycle".
KMS_DIR=./data/keys                # AES-wrapped master keys land here (app host)
KMS_WRAPPING_KEY=CHANGE_ME_generate_a_random_string   # wraps document master keys ONLY

# ── Auth / JWT (prototype: one long-lived access token, no refresh flow) ──
JWT_SECRET=CHANGE_ME_generate_a_random_string
JWT_ACCESS_TTL_SECONDS=28800        # 8 hours (demo convenience)
MFA_ISSUER=PRAMAAN
MFA_STEP_UP_MINUTES=15              # step-up MFA window before sensitive actions
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# ── Uploads ──
MAX_FILE_SIZE_MB=500               # 500 MB prototype limit (pre-verify pass buffers in RAM)
CHUNK_SIZE_BYTES=1048576            # 1 MB

# ── App ──
SECRET_KEY=CHANGE_ME_generate_a_random_string   # Flask cookie signing ONLY — does NOT wrap keys
CORS_ORIGINS=http://localhost:5173              # the Vite dev server
ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate each CHANGE_ME secret independently with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY, KMS_WRAPPING_KEY, and JWT_SECRET must be THREE DIFFERENT values.
