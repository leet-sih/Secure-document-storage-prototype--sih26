# ══════════════════════════════════════════════════════════════════
# .env.example — copy to .env and fill in. NEVER commit .env.
# PROTOTYPE config: only PostgreSQL + local file storage. No Redis/MinIO/Vault/Celery.
# ══════════════════════════════════════════════════════════════════

# ── Database (Flask is SYNC — psycopg driver, NOT asyncpg) ──
# Local backend -> host is localhost. Backend-in-Docker -> host is 'postgres'.
DATABASE_URL=postgresql+psycopg://dms_app_user:devpassword@localhost:5432/dms
POSTGRES_USER=dms_app_user
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=dms

# ── Local storage (prototype replacements for MinIO + Vault) ──
CHUNK_STORAGE_DIR=./data/chunks     # encrypted document chunks land here
KMS_DIR=./data/keys                 # AES-wrapped master keys land here

# ── Auth / JWT (prototype: one long-lived access token, no refresh flow) ──
JWT_SECRET=CHANGE_ME_generate_a_random_string
JWT_ACCESS_TTL_SECONDS=28800        # 8 hours (demo convenience)
MFA_ISSUER=SecureDMS
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# ── Uploads ──
MAX_FILE_SIZE_MB=100
CHUNK_SIZE_BYTES=1048576            # 1 MB

# ── App ──
SECRET_KEY=CHANGE_ME_generate_a_random_string   # Flask signing + AES-wraps TOTP/master keys
CORS_ORIGINS=http://localhost:5173              # the Vite dev server
ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate the two CHANGE_ME secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
